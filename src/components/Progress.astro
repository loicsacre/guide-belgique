---
import { getIndex } from '../lib/notions';
const { fiches, planned } = await getIndex();
const done = [...planned.keys()].filter((s) => fiches.has(s)).length;
const total = planned.size;
const pct = total ? Math.round((done / total) * 100) : 0;
---
<div class="progress not-content">
  <div class="progress-label"><strong>{done} / {total}</strong> notions du niveau 1 rédigées · {fiches.size} fiches au total</div>
  <div class="progress-bar" role="progressbar" aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100"><span style={`width:${pct}%`}></span></div>
</div>
