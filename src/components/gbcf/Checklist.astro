---
// La checklist par phases : à cocher sur papier, à parcourir sur le web.
import { inlineRenderer } from '../../lib/gbcf';
interface Props { data: any }
const { data } = Astro.props;
const h = await inlineRenderer();
---
{(data.checklist?.length ?? 0) > 0 && (
  <div class="gb-checklist">
    {data.checklist.map((p: any) => (
      <section>
        <h4>{p.phase}{p.quand && <small>{p.quand}</small>}</h4>
        <ul>{p.items.map((i: string) => <li set:html={h(i)} />)}</ul>
      </section>
    ))}
  </div>
)}
