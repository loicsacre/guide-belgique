---
// Les autres façons de lire ce contenu (bandeau en tête de page).
import { downloads, getQuiz, getLivres } from '../../lib/gbcf';
interface Props { slug: string; data: any }
const { slug, data } = Astro.props;
const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasMemo = !!data.memo;
const hasFiche = (data.checklist?.length ?? 0) > 0 || hasMemo;
const quiz = getQuiz(slug);
const livres = getLivres().filter((l) => l.chapitres.includes(slug));
const show = hasMemo || hasFiche || quiz || livres.length;
---
{show && (
  <nav class="gb-formats not-content" aria-label="Autres formats">
    <span class="gb-formats-label">Lire autrement</span>
    {hasMemo && <a href={`${B}/${downloads.memo(slug)}`} data-fallback={`${B}/imprimer/memo/${slug}/`}>📄 Mémo · 1 page</a>}
    {hasFiche && <a href={`${B}/${downloads.fiche(slug)}`} data-fallback={`${B}/imprimer/fiche/${slug}/`}>🖨️ Fiche à imprimer</a>}
    {quiz && <a href="#quiz">🧠 Quiz · {quiz.questions.length} questions</a>}
    {livres.map((l) => <a href={`${B}/bibliotheque/#livre-${l.id}`}>📖 Livre « {l.titre} »</a>)}
  </nav>
)}
<script>
  // Les PDF n'existent qu'après `npm run export` (CI) : en local, on retombe sur la page d'impression.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.gb-formats a[data-fallback]')) {
    fetch(a.href, { method: 'HEAD' }).then((r) => { if (!r.ok) a.href = a.dataset.fallback!; }).catch(() => (a.href = a.dataset.fallback!));
  }
</script>
