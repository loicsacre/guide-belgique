---
// Quiz : interactif sur le web (mode "web"), questions puis corrigé séparé sur papier (mode "papier").
import { getQuiz, answerText, shuffled, inlineRenderer } from '../../lib/gbcf';
import { SAVOIRS } from '../../lib/domains.mjs';
import { getIndex } from '../../lib/notions';
interface Props { slug: string; mode?: 'web' | 'papier' | 'corrige'; heading?: boolean }
const { slug, mode = 'web', heading = true } = Astro.props;
const quiz = getQuiz(slug);
const h = await inlineRenderer();
const { fiches, titleOf } = await getIndex();
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const sv = (k?: string) => (k ? SAVOIRS[k as keyof typeof SAVOIRS] : null);
---
{quiz && mode === 'web' && (
  <section class="gb-quiz not-content" data-quiz={slug}>
    {heading && <h2 id="quiz">Teste-toi</h2>}
    {quiz.titre && <p class="gb-quiz-intro">{quiz.titre}</p>}
    <ol class="gb-q-list">
      {quiz.questions.map((q) => (
        <li class="gb-q" data-type={q.type} data-answer={q.type === 'ordre' ? JSON.stringify(q.ordre) : JSON.stringify(q.reponse)} data-tol={q.tolerance ?? 0}>
          {sv(q.savoir) && <span class="gb-savoir">{sv(q.savoir)!.emoji} {sv(q.savoir)!.label}</span>}
          <p class="gb-q-text" set:html={h(q.question)} />
          {q.type === 'qcm' && <div class="gb-choices">{q.choix!.map((c, i) => <button type="button" data-v={i}><b>{String.fromCharCode(65 + i)}</b> <span set:html={h(c)} /></button>)}</div>}
          {q.type === 'vrai-faux' && <div class="gb-choices gb-row"><button type="button" data-v="true">Vrai</button><button type="button" data-v="false">Faux</button></div>}
          {q.type === 'nombre' && <form class="gb-number"><input type="text" inputmode="decimal" aria-label="Ta réponse" />{q.unite && <span>{q.unite}</span>}<button type="submit">Valider</button></form>}
          {q.type === 'ordre' && (
            <div class="gb-order">
              <ol>{shuffled(q.ordre!, q.id).map((x) => <li data-item={x}><span>{x}</span><button type="button" class="up" aria-label="Monter">↑</button><button type="button" class="down" aria-label="Descendre">↓</button></li>)}</ol>
              <button type="button" class="gb-check">Valider l'ordre</button>
            </div>
          )}
          <div class="gb-expl" hidden>
            <p class="gb-verdict"></p>
            <p><strong>Réponse : {answerText(q)}.</strong> <span set:html={h(q.explication)} /></p>
            {q.notions && q.notions.length > 0 && <p class="gb-q-notions">Pour approfondir : {q.notions.map((n, k) => <>{k > 0 && ' · '}{fiches.has(n) ? <a href={`${BASE}/fiches/${n}/`}>{titleOf(n)}</a> : titleOf(n)}</>)}</p>}
          </div>
        </li>
      ))}
    </ol>
    <p class="gb-score" hidden></p>
  </section>
)}
{quiz && mode === 'papier' && (
  <section class="gb-quiz-paper">
    {heading && <h3>Teste-toi</h3>}
    <ol>
      {quiz.questions.map((q) => (
        <li>
          <p set:html={h(q.question)} />
          {q.type === 'qcm' && <ul class="gb-paper-choices">{q.choix!.map((c, i) => <li>□ {String.fromCharCode(65 + i)}. <span set:html={h(c)} /></li>)}</ul>}
          {q.type === 'vrai-faux' && <p class="gb-paper-choices">□ Vrai &nbsp;&nbsp; □ Faux</p>}
          {q.type === 'nombre' && <p class="gb-paper-line">Réponse : ............................ {q.unite}</p>}
          {q.type === 'ordre' && <ul class="gb-paper-choices">{shuffled(q.ordre!, q.id).map((x) => <li>___ {x}</li>)}</ul>}
        </li>
      ))}
    </ol>
  </section>
)}
{quiz && mode === 'corrige' && (
  <ol class="gb-corrige">
    {quiz.questions.map((q) => <li><strong>{answerText(q)}.</strong> <span set:html={h(q.explication)} /></li>)}
  </ol>
)}

<script>
  const norm = (s: string) => Number(s.replace(/\s| |€/g, '').replace(',', '.'));
  for (const root of document.querySelectorAll<HTMLElement>('.gb-quiz')) {
    const qs = [...root.querySelectorAll<HTMLElement>('.gb-q')];
    let done = 0, ok = 0;
    const finish = (q: HTMLElement, good: boolean) => {
      if (q.dataset.done) return;
      q.dataset.done = '1';
      done++; if (good) ok++;
      q.classList.add(good ? 'is-ok' : 'is-ko');
      const ex = q.querySelector<HTMLElement>('.gb-expl')!;
      ex.hidden = false;
      ex.querySelector('.gb-verdict')!.textContent = good ? 'Bien vu.' : 'Pas tout à fait.';
      q.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button, input').forEach((b) => (b.disabled = true));
      if (done === qs.length) {
        const s = root.querySelector<HTMLElement>('.gb-score')!;
        s.hidden = false;
        s.textContent = `${ok} bonne${ok > 1 ? 's' : ''} réponse${ok > 1 ? 's' : ''} sur ${qs.length}. Les explications et les fiches liées restent là si tu veux y revenir.`;
      }
    };
    for (const q of qs) {
      const answer = JSON.parse(q.dataset.answer!);
      const type = q.dataset.type;
      if (type === 'qcm' || type === 'vrai-faux') {
        q.querySelectorAll<HTMLButtonElement>('.gb-choices button').forEach((b) =>
          b.addEventListener('click', () => {
            const v = type === 'qcm' ? Number(b.dataset.v) : b.dataset.v === 'true';
            b.classList.add('picked');
            q.querySelectorAll<HTMLButtonElement>('.gb-choices button').forEach((x) => {
              const xv = type === 'qcm' ? Number(x.dataset.v) : x.dataset.v === 'true';
              if (xv === answer) x.classList.add('right');
            });
            finish(q, v === answer);
          }),
        );
      }
      if (type === 'nombre') {
        q.querySelector('form')!.addEventListener('submit', (ev) => {
          ev.preventDefault();
          const v = norm(q.querySelector('input')!.value);
          if (Number.isNaN(v)) return;
          finish(q, Math.abs(v - answer) <= Number(q.dataset.tol));
        });
      }
      if (type === 'ordre') {
        const list = q.querySelector('.gb-order ol')!;
        list.addEventListener('click', (ev) => {
          const b = (ev.target as HTMLElement).closest('button');
          if (!b) return;
          const li = b.closest('li')!;
          if (b.classList.contains('up') && li.previousElementSibling) list.insertBefore(li, li.previousElementSibling);
          if (b.classList.contains('down') && li.nextElementSibling) list.insertBefore(li.nextElementSibling, li);
        });
        q.querySelector('.gb-check')!.addEventListener('click', () => {
          const got = [...list.querySelectorAll<HTMLElement>('li')].map((li) => li.dataset.item);
          got.forEach((x, i) => list.children[i].classList.add(x === answer[i] ? 'right' : 'wrong'));
          finish(q, got.every((x, i) => x === answer[i]));
        });
      }
    }
  }
</script>
