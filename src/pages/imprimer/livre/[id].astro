---
// Un petit livre, construit comme le site : pour chaque chapitre du manuel, sa présentation, ses fiches dans
// l'ordre de lecture, puis ses mises en situation. En fin de livre : quiz facultatifs, corrigés, sources.
// Format A5 (cahier, reMarkable, impression en livret). La même page sert de source à l'EPUB :
// chaque bloc [data-epub-file] devient un fichier du livre.
import { render } from 'astro:content';
import Print from '../../../layouts/Print.astro';
import Quiz from '../../../components/gbcf/Quiz.astro';
import { getLivres, resolveLivre, SITE_URL, type Livre } from '../../../lib/gbcf';
import { slugOf, fmtDate } from '../../../lib/notions';
import { qrSvg } from '../../../lib/qr';

export async function getStaticPaths() {
  return getLivres().map((livre) => ({ params: { id: livre.id }, props: { livre } }));
}
const { livre } = Astro.props as { livre: Livre };
const { chapitres, extra } = await resolveLivre(livre);
const renderAll = (list: any[]) => Promise.all(list.map(async (e) => ({ e, slug: slugOf(e), Content: (await render(e)).Content })));
const parts = await Promise.all(
  chapitres.map(async (x) => ({
    ...x,
    fichesR: await renderAll(x.fiches),
    situationsR: await Promise.all(x.situations.map(async (e: any) => ({ e, slug: slugOf(e), Content: (await render(e)).Content, qr: await qrSvg(`${SITE_URL}/${e.id}/`) }))),
    qr: await qrSvg(`${SITE_URL}/chapitres/${x.c.id}/`),
  })),
);
const extraR = await renderAll(extra);
const withQuiz = parts.filter((p) => p.quiz);
const sources = new Map<string, { title: string; url: string; org?: string }>();
for (const p of parts) for (const e of [...p.fiches, ...p.situations]) for (const s of e.data.sources ?? []) sources.set(s.url, s);
for (const e of extra) for (const s of e.data.sources ?? []) sources.set(s.url, s);
const today = new Date();
const chain = (fil?: string) => (fil ?? '').split('→').map((x) => x.trim()).filter(Boolean);
---
<Print title={livre.titre} format="a5" kind="livre" description={livre.sous_titre}>
  <section class="cover" style={livre.couleur ? `--gb-cover:${livre.couleur}` : ''} data-epub-file="couverture" data-epub-title="Couverture">
    <div class="cover-kicker">La vie adulte en Belgique</div>
    <div>
      <h1>{livre.titre}</h1>
      {livre.sous_titre && <p class="cover-sub">{livre.sous_titre}</p>}
    </div>
    <div>
      <div class="cover-bar"></div>
      <p class="cover-meta">Édition du {today.toLocaleDateString('fr-BE', { day: 'numeric', month: 'long', year: 'numeric' })} · {SITE_URL.replace('https://', '')}<br />Un manuel pour comprendre, pas un conseil personnalisé. Les règles datées sont signalées 🔴, les repères 🟠, les exemples inventés 🔵.</p>
    </div>
  </section>

  <section class="toc" data-epub-file="sommaire" data-epub-title="Sommaire">
    <h2>Sommaire</h2>
    {parts.map((p) => (
      <>
        <h3 class="toc-part">{p.c.title}</h3>
        <ol>
          {p.fichesR.map((f) => <li><a href={`#fiche-${f.slug}`}>{f.e.data.title}</a></li>)}
        </ol>
        {p.situationsR.length > 0 && <ul>{p.situationsR.map((s) => <li><a href={`#sit-${s.slug}`}>En situation : {s.e.data.title}</a></li>)}</ul>}
      </>
    ))}
    {extraR.length > 0 && (<><h3 class="toc-part">Pour compléter</h3><ol>{extraR.map((f) => <li><a href={`#fiche-${f.slug}`}>{f.e.data.title}</a></li>)}</ol></>)}
    <h3 class="toc-part">Fin du livre</h3>
    <ul>
      {withQuiz.length > 0 && <li><a href="#quiz">Quiz facultatifs et corrigés</a></li>}
      <li><a href="#sources">Sources</a></li>
    </ul>
    <h3>Comment lire ce livre</h3>
    <p>Chaque chapitre s'ouvre sur une vue d'ensemble, puis présente ses notions une par une, dans un ordre de lecture possible. Chaque fiche se lit seule : commence où tu veux. Les mises en situation viennent ensuite, pour voir ces notions fonctionner ensemble dans une histoire. Les calculateurs et les documents annotés restent en ligne : les QR codes y mènent.</p>
  </section>

  {parts.map((p) => (
    <>
      <section class="part-title chap-opener" id={`chap-${p.c.id}`} data-epub-file={`chap-${p.c.id}`} data-epub-title={p.c.title}>
        <div class="print-badge">Chapitre</div>
        <h1>{p.c.title}</h1>
        {p.c.intro && <p class="print-lede">{p.c.intro}</p>}
        {p.c.presentation && <p>{p.c.presentation}</p>}
        {chain(p.c.fil).length > 1 && <p class="chap-chain">{chain(p.c.fil).join(' → ')}</p>}
        <div class="print-qr chap-qr"><Fragment set:html={p.qr} />Le chapitre en ligne</div>
      </section>
      {p.fichesR.map(({ e, slug, Content }) => (
        <section class="annexe-fiche" id={`fiche-${slug}`} data-epub-file={`fiche-${slug}`} data-epub-title={e.data.title} data-epub-group={p.c.title}>
          <h1>{e.data.title}</h1>
          {e.data.short && <p class="fiche-short"><strong>En une phrase —</strong> {e.data.short}</p>}
          <Content />
          <p class="print-footer"><span>Vérifié : {fmtDate(e.data.last_verified)}{e.data.valid_for && <> · valable pour : {e.data.valid_for}</>}</span></p>
        </section>
      ))}
      {p.situationsR.map(({ e, slug, Content, qr }) => (
        <section class="chapitre" id={`sit-${slug}`} data-epub-file={`sit-${slug}`} data-epub-title={`En situation : ${e.data.title}`} data-epub-group={p.c.title}>
          <header class="print-head">
            <div>
              <div class="print-badge">Mise en situation</div>
              <h1>{e.data.title}</h1>
              {e.data.description && <p class="print-lede">{e.data.description}</p>}
            </div>
            <div class="print-qr"><Fragment set:html={qr} />En ligne</div>
          </header>
          <Content />
        </section>
      ))}
      <div class="notes-page"><h2>Mes notes — {p.c.title}</h2><div class="notes-lines"></div></div>
    </>
  ))}

  {extraR.length > 0 && (
    <>
      <section class="part-title" data-epub-file="complements" data-epub-title="Pour compléter">
        <div class="print-badge">Pour compléter</div>
        <h1>Notions voisines</h1>
        <p class="print-lede">Quelques fiches d'autres chapitres, utiles pour lire celui-ci.</p>
      </section>
      {extraR.map(({ e, slug, Content }) => (
        <section class="annexe-fiche" id={`fiche-${slug}`} data-epub-file={`fiche-${slug}`} data-epub-title={e.data.title} data-epub-group="Pour compléter">
          <h1>{e.data.title}</h1>
          {e.data.short && <p class="fiche-short"><strong>En une phrase —</strong> {e.data.short}</p>}
          <Content />
        </section>
      ))}
    </>
  )}

  {withQuiz.length > 0 && (
    <section class="chapitre" id="quiz" data-epub-file="quiz" data-epub-title="Quiz facultatifs et corrigés">
      <h1>Envie de vérifier ?</h1>
      <p class="print-lede">Un quiz facultatif par chapitre. Les corrigés suivent, avec leurs explications.</p>
      {withQuiz.map((p) => <><h2>{p.c.title}</h2><Quiz slug={p.c.id} mode="papier" heading={false} /></>)}
      <h1 class="page-break">Corrigés</h1>
      {withQuiz.map((p) => <><h2>{p.c.title}</h2><Quiz slug={p.c.id} mode="corrige" /></>)}
    </section>
  )}

  <section class="chapitre" id="sources" data-epub-file="sources" data-epub-title="Sources">
    <h1>Sources</h1>
    <ul>{[...sources.values()].map((s) => <li>{s.title}{s.org && <> — {s.org}</>} · <a href={s.url}>{s.url.replace(/^https?:\/\//, '')}</a></li>)}</ul>
  </section>
</Print>
